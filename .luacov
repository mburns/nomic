-- LuaCov configuration file

-- Patterns for files to include
include = {
  "src/.*"
}

-- Patterns for files to exclude
exclude = {
  "test/.*"
}

-- File to save stats collected
statsfile = "luacov.stats.out"

-- File to save report
reportfile = "luacov.report.out"

-- Run reporter on completion
runreport = true

-- Delete stats file after generating report
deletestats = false

-- Modules to include in the report
modules = {
  ["nomic.*"] = "src"
} 