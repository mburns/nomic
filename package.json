{
	"name": "nomic-game",
	"version": "1.0.0",
	"description": "A Nomic game implementation with automated voting and scoring",
	"main": "dist/index.js",
	"scripts": {
		"build": "tsc",
		"start": "node dist/index.js",
		"dev": "ts-node src/index.ts",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format .",
		"format:fix": "biome format --write .",
		"type-check": "tsc --noEmit",
		"clean": "rm -rf dist",
		"prebuild": "npm run clean",
		"postinstall": "npm run build",
		"generate-rules": "node scripts/generate-rules-summary.js",
		"install-deps": "npm ci",
		"dev-setup": "npm ci && npm run build",
		"check": "npm run lint && npm run format:fix && npm test",
		"all": "npm run install-deps && npm run check"
	},
	"keywords": [
		"nomic",
		"game",
		"voting",
		"rules"
	],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^2.0.6",
		"@types/jest": "^29.5.8",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^20.8.10",
		"jest": "^29.7.0",
		"ts-jest": "^29.1.1",
		"ts-node": "^10.9.1",
		"typescript": "^5.2.2"
	},
	"dependencies": {
		"@octokit/rest": "^20.0.2",
		"js-yaml": "^4.1.0",
		"zod": "^3.22.4"
	},
	"engines": {
		"node": ">=22.0.0"
	}
}
